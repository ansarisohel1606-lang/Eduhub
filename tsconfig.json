{
  "compilerOptions": {
     "types": ["node"],
    "target": "ES2022",
    "module": "CommonJS",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src", "config/config.js"],
  "exclude": ["node_modules", "dist"]
}